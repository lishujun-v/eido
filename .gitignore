# ---------- 隐藏文件 ----------
.*
!.github/
!.github/workflows/
!.github/workflows/*.yml

# ---------- 依赖 ----------
# Node
node_modules/
# Python
.venv/
venv/
env/
*.egg-info/

# ---------- 构建产物 ----------
# Next.js
.next/
out/
build/
next-env.d.ts
*.tsbuildinfo
# Python 编译
__pycache__/
*.py[cod]
*$py.class

# ---------- 运行时输出 / 本地数据 ----------
/output/
/outputs/

# 本地模型文件通常体积很大，仅保留下载说明。
/data/models/*
!/data/models/README.md

# database 保存用户、会话、Provider 配置等本地运行数据。
# 不提交任何运行数据，只保留说明和可复用的 Agent Skills。
/database/*
!/database/README.md
!/database/agents/
/database/agents/*
!/database/agents/skills/
!/database/agents/skills/**
/database/agents/skills/**/__pycache__/
/database/agents/skills/**/*.py[cod]

runtime/graphs/.trash/
runtime/workspace/.eido/agent-skills/
runtime/workspace/output/
runtime/projects/note-down/outputs/

# ---------- 环境变量 / 密钥 ----------
.env
.env.local
.env.*.local

# ---------- 日志 ----------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------- 缓存 ----------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.eslintcache
.cache/

# ---------- IDE / 编辑器 ----------
.vscode/
.idea/
*.swp
*.swo

# ---------- 操作系统 ----------
.DS_Store
Thumbs.db
